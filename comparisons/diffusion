# utility functions
def get_upper_triangle(matrix):
    idx = torch.triu_indices(90, 90, offset=1)
    return matrix[:, idx[0], idx[1]]

def reconstruct_matrix(vec):
    B = vec.shape[0]
    mat_A = torch.zeros(B, 90, 90, device=vec.device)
    idx = torch.triu_indices(90, 90, offset=1)
    mat_A[:, idx[0], idx[1]] = vec
    mat_A[:, idx[1], idx[0]] = vec
    return mat_A


# embeddings
# we need to know the timepoint for the diffusion model
class TimeEmbedding(nn.Module):
    def __init__(self, dim):
        super().__init__()
        self.linear = nn.Linear(1, dim)

    def forward(self, t):
        # return torch.relu(self.linear(t.unsqueeze(-1)))
        return torch.relu(self.linear(t.view(-1, 1)))

# we also need to know the age of the subject
class AgeEmbedding(nn.Module):
    def __init__(self, dim):
        super().__init__()
        self.net = nn.Sequential(
            nn.Linear(1, dim),
            nn.ReLU(),
            nn.Linear(dim, dim)
        )

    def forward(self, age):
        # return self.net(age.unsqueeze(-1))
        return self.net(age.view(-1, 1))

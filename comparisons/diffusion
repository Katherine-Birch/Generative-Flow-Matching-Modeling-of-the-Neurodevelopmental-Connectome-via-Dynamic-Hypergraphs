class SinusoidalEmbedding(nn.Module):
    def __init__(self, dim):
        super().__init__()
        self.dim = dim

    def forward(self, t):
        # t can be [B] or [B, 1]
        device = t.device
        half_dim = self.dim // 2

        # 1. Force t to be exactly [B, 1]
        t = t.view(-1, 1)

        # 2. Calculate frequencies
        # log(10000) / (half_dim - 1) is the standard base for transformer-style embeddings
        freq_seq = torch.arange(half_dim, device=device).float()
        inv_freq = torch.exp(freq_seq * -(math.log(10000.0) / (half_dim - 1)))

        # 3. Multiply: [B, 1] * [1, half_dim] -> [B, half_dim]
        args = t * inv_freq[None, :]

        # 4. Concatenate sin and cos to get [B, dim]
        embeddings = torch.cat((args.sin(), args.cos()), dim=-1)
        return embeddings

# model
class DiffusionModelMLP(nn.Module):
    def __init__(self, input_dim, hidden_dim, cond_dim):
        super().__init__()
        # self.time_embed = TimeEmbedding(cond_dim)
        # self.age_embed = AgeEmbedding(cond_dim)
        self.time_mlp = nn.Sequential(
            SinusoidalEmbedding(cond_dim),
            nn.Linear(cond_dim, cond_dim),
            nn.GELU(),
            nn.Linear(cond_dim, cond_dim)
        )

        self.age_embed = AgeEmbedding(cond_dim)


        self.mlp = nn.Sequential(
            nn.Linear(input_dim + 2*cond_dim, hidden_dim),
            nn.GELU(),
            nn.Linear(hidden_dim, hidden_dim),
            nn.GELU(),
            nn.Linear(hidden_dim, input_dim)
        )

        self.use_transformer = False
        self.use_hypergraph = False
        self.use_topo_mask = False

    # def forward(self, x, t, age):
    #     time_emb = self.time_embed(t)
    #     age_emb = self.age_embed(age)
    #     h = torch.cat([x, time_emb, age_emb], dim=-1)
    #     return self.mlp(h)
    def forward(self, x, t, age, static_node_features=None, edge_indices=None, force_null = False):
        # time_emb = self.time_embed(t)
        if t.dim() == 1:
            t = t.unsqueeze(-1)  # ensure t is [B, 1] for embedding

        time_emb = self.time_mlp(t)
        age_emb = self.age_embed(age)
        h = torch.cat([x, time_emb, age_emb], dim=-1)
        return self.mlp(h)


class DiffusionSteps:
    def __init__(self, T_steps=1000):
        self.T_steps = T_steps
        self.betas = torch.linspace(1e-4, 0.02, T_steps)
        self.alphas = 1 - self.betas
        self.alpha_cumprod = torch.cumprod(self.alphas, dim=0)

    def sample_timestep(self, batch_size):
        return torch.randint(0, self.T_steps, (batch_size,))

    def forward_diffusion(self, x0, t):
        noise = torch.randn_like(x0)
        # alpha_prod = self.alpha_cumprod[t].unsqueeze(-1).to(x0.device)
        alpha_prod = self.alpha_cumprod.to(t.device)[t].unsqueeze(-1)
        xt = torch.sqrt(alpha_prod) * x0 + torch.sqrt(1 - alpha_prod) * noise
        return xt, noise


# training and experimenting

def train_diffusion_model(model, diffusion_steps, x0, age, static_features, edge_idx, optimizer, uncond_prob=0.1):
    batch_size = x0.shape[0]
    t = diffusion_steps.sample_timestep(batch_size).to(x0.device)

    xt, noise = diffusion_steps.forward_diffusion(x0, t)
    t_norm = t.float() / diffusion_steps.T_steps  # normalize time to [0, 1]

    is_null = np.random.rand() < uncond_prob

    if is_null:
        age_cond = torch.full_like(age.view(-1, 1), -10.0)
    else:
        age_cond = age.view(-1, 1)

    # cond_mask = (torch.rand(batch_size, device=x0.device) > uncond_prob).float()  # 1 for cond, 0 for uncond
    # cond_mask = (torch.rand(batch_size, 1, device=x0.device) > uncond_prob).float()  # shape (B, 1) to broadcast over age embedding
    # age_col = age.view(-1, 1)
    # age_cond = age * cond_mask.unsqueeze(-1)  if age.dim() == 1 else age * cond_mask  # zero out age for uncond samples
    # age_cond = age_col * cond_mask  # shape (B, 1) to broadcast over age embedding
    # age_cond = torch.where(cond_mask == 1, age_col, torch.tensor(-10.0, device=x0.device))  # set uncond age to -10 for clear separation
    pred_noise = model(xt, t_norm, age_cond, static_features, edge_idx, force_null=is_null)
    # pred_noise = model(xt, t_norm, age_cond, static_features, edge_idx)
    loss = F.mse_loss(pred_noise, noise)

    optimizer.zero_grad()
    loss.backward()
    optimizer.step()

    return loss.item()

@torch.no_grad()
def sample_from_diff(model, diffusion_steps, target_age, static_node_features, edge_indices, guidance_scale=5.0):
    model.eval()
    device = next(model.parameters()).device
    num_samples = 1
    cond_age = torch.tensor([(target_age - 35.0) / 5.0], dtype=torch.float32, device=device)
    uncond_age = torch.tensor([-10.0], dtype=torch.float32, device=device)

    x = torch.randn(num_samples, 4005, device=device)  # start from noise
    # cond_age = torch.tensor([target_age],dtype=torch.float32, device=device)
    # uncond_age = torch.tensor([0.0],dtype=torch.float32, device=device) # zero age for uncond
    for t in reversed(range(diffusion_steps.T_steps)):
        t_batch = torch.full((num_samples,), t, device=device)
        t_norm = t_batch.float() / diffusion_steps.T_steps

        if guidance_scale > 1.0:
            pred_noise_cond = model(x, t_norm, cond_age, static_node_features, edge_indices, force_null=False)
            pred_noise_uncond = model(x, t_norm, uncond_age, static_node_features, edge_indices, force_null=True)
            pred_noise = pred_noise_uncond + guidance_scale * (pred_noise_cond - pred_noise_uncond)
        else:
            pred_noise = model(x, t_norm, cond_age, static_node_features, edge_indices, force_null=False)
        # pred_noise = model(x, t_norm, age)

        alpha = diffusion_steps.alphas[t].to(x.device)
        alpha_prod = diffusion_steps.alpha_cumprod[t].to(x.device)

        x = (1 / torch.sqrt(alpha)) * (x - (1 - alpha) / torch.sqrt(1 - alpha_prod) * pred_noise)

        if t > 0:
            noise = torch.randn_like(x)
            beta = diffusion_steps.betas[t].to(x.device)
            x += torch.sqrt(beta) * noise

    return x


@torch.no_grad()
def sample_from_ddim(model, diffusion_steps, target_age, static_node_features, edge_indices, guidance_scale=5.0,
                     ddim_steps=50):
    model.eval()
    device = next(model.parameters()).device
    num_samples = 1

    cond_age = torch.tensor([(target_age - 35.0) / 5.0], dtype=torch.float32, device=device)
    uncond_age = torch.tensor([-10.0], dtype=torch.float32, device=device)

    x = torch.randn(num_samples, 4005, device=device)

    # 1. Create a skipped timestep schedule (e.g., 50 steps instead of 1000)
    step_size = diffusion_steps.T_steps // ddim_steps
    timesteps = list(range(0, diffusion_steps.T_steps, step_size))[::-1]

    for i, t in enumerate(timesteps):
        t_batch = torch.full((num_samples,), t, device=device)
        t_norm = t_batch.float() / diffusion_steps.T_steps

        # 2. Classifier-Free Guidance
        if guidance_scale > 1.0:
            pred_noise_cond = model(x, t_norm, cond_age, static_node_features, edge_indices, force_null=False)
            pred_noise_uncond = model(x, t_norm, uncond_age, static_node_features, edge_indices, force_null=True)
            pred_noise = pred_noise_uncond + guidance_scale * (pred_noise_cond - pred_noise_uncond)
        else:
            pred_noise = model(x, t_norm, cond_age, static_node_features, edge_indices, force_null=False)

        # 3. DDIM Math
        alpha_prod_t = diffusion_steps.alpha_cumprod[t].to(device)

        # Get the alpha for the NEXT step we are jumping to (or 1.0 if we are at the end)
        prev_t = timesteps[i + 1] if i < len(timesteps) - 1 else -1
        alpha_prod_t_prev = diffusion_steps.alpha_cumprod[prev_t].to(device) if prev_t >= 0 else torch.tensor(1.0,device=device)


        # Predict x0 (the fully denoised graph)
        pred_x0 = (x - torch.sqrt(1 - alpha_prod_t) * pred_noise) / torch.sqrt(alpha_prod_t)

        # Direction pointing to x_t (the deterministic noise)
        dir_xt = torch.sqrt(1 - alpha_prod_t_prev) * pred_noise

        # Step backwards
        x = torch.sqrt(alpha_prod_t_prev) * pred_x0 + dir_xt

    return x

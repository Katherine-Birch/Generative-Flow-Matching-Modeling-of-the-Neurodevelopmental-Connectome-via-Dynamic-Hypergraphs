def sanitize_and_prep(R, S):
    S = np.nan_to_num(S, nan=0.0, posinf=1e6, neginf=0.0)
    S = np.clip(S, a_min=0.0, a_max=1e6)
    if np.max(S) > 20: S = np.log1p(S)
    if np.max(R) > 20: R = np.log1p(R)
    R = (R + R.T) / 2
    S = (S + S.T) / 2
    np.fill_diagonal(R, 0)
    np.fill_diagonal(S, 0)
    return R, S


def calculate_population_fidelity(real_mats, syn_mats):
    mean_real = np.mean(real_mats, axis=0)
    mean_syn = np.mean(syn_mats, axis=0)

    R_mean, S_mean = sanitize_and_prep(mean_real, mean_syn)

    wd = wasserstein_distance(R_mean.flatten(), S_mean.flatten())
    spec = wasserstein_distance(eigh(R_mean, eigvals_only=True), eigh(S_mean, eigvals_only=True))

    Rb, Sb = (R_mean > 0.5).astype(float), (S_mean > 0.5).astype(float)
    G_R, G_S = nx.from_numpy_array(Rb), nx.from_numpy_array(Sb)

    clust_err = abs(nx.average_clustering(G_R) - nx.average_clustering(G_S))
    eff_err = abs(nx.global_efficiency(G_R) - nx.global_efficiency(G_S))

    return wd, spec, clust_err, eff_err


def unified_sampler(model_name, model, target_age, device, static_node_features, edge_indices, guidance_scale=2.0,
                    num_steps=100):
    model.eval()
    if "CVAE" in model_name or hasattr(model, 'is_cvae'):
        norm_age = torch.tensor([[(target_age - 35.0) / 5.0]], device=device, dtype=torch.float32)
        with torch.no_grad():
            # Clamp the log output to prevent expm1 explosion
            vec_log = torch.clamp(model.sample(norm_age), max=20.0)
            vec = torch.clamp(torch.expm1(vec_log), min=0).cpu().numpy().flatten()
    elif "DDIM" in model_name:
        diffusion_steps = DiffusionSteps(T_steps=1000)
        vec = sample_from_ddim(model, diffusion_steps, target_age, static_node_features, edge_indices, guidance_scale,
                               ddim_steps=50)
        vec = vec * model.global_std + model.global_mean
        vec = torch.clamp(torch.expm1(vec), min=0).cpu().numpy().flatten()
    elif "MLP" in model_name or "DDPM" in model_name or "Diffusion" in model_name:
        diffusion_steps = DiffusionSteps(T_steps=1000)
        vec = sample_from_diff(model, diffusion_steps, target_age, static_node_features, edge_indices, guidance_scale)
        vec = vec * model.global_std + model.global_mean
        vec = torch.clamp(torch.expm1(vec), min=0).cpu().numpy().flatten()
    else:
        from ablation_runner import sample_brain_graph
        vec = sample_brain_graph(model, target_age, device, static_node_features, edge_indices, guidance_scale,
                                 num_steps)

    vec = np.nan_to_num(vec, nan=0.0, posinf=1e6, neginf=0.0)
    # Hard clamp to prevent Diffusion infinity explosions from breaking Seaborn
    vec = np.clip(vec, a_min=0.0, a_max=1e6)
    return vec


def run_age_holdout_experiment(dataset, target_ages=[30, 34, 38], window=1.0, seeds=[42]):
    results_master = []
    all_trained_models_master = {}
    if torch.cuda.is_available():
        device = torch.device('cuda')
    elif torch.backends.mps.is_available():
        device = torch.device('mps')
    else:
        device = torch.device('cpu')

    for age in target_ages:
        print(f"\n" + "=" * 40 + f"\nTESTING HOLD-OUT AGE: {age}w\n" + "=" * 40)

        all_ages = dataset.metadata['AgeGA'].values
        test_mask = np.abs(all_ages - age) <= (window / 2)
        train_val_idx = np.where(~test_mask)[0]
        test_idx = np.where(test_mask)[0]

        if len(test_idx) == 0:
            print(f" No samples found for age {age}. Skipping.")
            continue

        train_idx, val_idx = train_test_split(train_val_idx, test_size=0.15, random_state=42)
        train_set = Subset(dataset, train_idx)
        val_set = Subset(dataset, val_idx)

        configs = {
            f"Flow_Matching_Holdout_{age}w": {
                "use_transformer": True, "use_hypergraph": True, "use_topo_mask": True, "hidden_dim": 32,
                "internal_dim": 256
            },
            f"CVAE_Baseline_Holdout_{age}w": {
                "is_cvae": True, "latent_dim": 128
            },
            f"Diffusion_Baseline_Holdout_{age}w": {
                "is_diffusion": True, "hidden_dim": 2048, "cond_dim": 64
            },
            f"Graph_Aware_DDIM_Holdout_{age}w": {
                "is_diffusion": True,
                "use_transformer": True,
                "use_hypergraph": True,
                "use_topo_mask": True,
                "hidden_dim": 32,
                "internal_dim": 256
            }

        }

        for seed in seeds:
            torch.manual_seed(seed)

            trained_models, static_features, edge_idx, all_histories = run_ablation_study(
                ablation_configs=configs,
                full_dataset=dataset,
                train_loader=DataLoader(train_set, batch_size=16, shuffle=True),
                val_loader=DataLoader(val_set, batch_size=16, shuffle=False),
                device=device,
                # epochs=150,
                epochs=300,
                skip_existing=True
            )

            real_mats = dataset.matrices[test_idx]

            for name, model in trained_models.items():
                print(f"  Evaluating zero-shot interpolation for: {name}")

                cfg_scale = 1.0 if any(kw in name for kw in ["Flow", "CVAE"]) else 2.0

                syn_vectors = [
                    unified_sampler(name, model, age, device, static_features, edge_idx, guidance_scale=cfg_scale)
                    for _ in range(len(real_mats))
                ]
                syn_mats = [vector_to_adjacency_matrix(v, 90) for v in syn_vectors]

                # Single evaluation step using the Population Math
                wd, spec, clust_err, eff_err = calculate_population_fidelity(real_mats, syn_mats)

                results_master.append({
                    "Age": age,
                    "Model": name.split("_Holdout")[0],
                    "Seed": seed,
                    "WD": wd,
                    "Spec_WD": spec,
                    "Clust_MAE": clust_err,
                    "Eff_MAE": eff_err
                })

            all_trained_models_master.update(trained_models)

    # return pd.DataFrame(results_master)
    return pd.DataFrame(results_master), all_trained_models_master, device, static_features, edge_idx

def plot_extended_holdout_results(df):
    sns.set_theme(style="whitegrid", palette="deep")
    fig, axes = plt.subplots(2, 2, figsize=(14, 10))

    metrics = [
        ("WD", "Edge Weight Fidelity (Flattened WD)", axes[0, 0]),
        ("Spec_WD", "Structural Topology (Spectral WD)", axes[0, 1]),
        ("Clust_MAE", "Local Segregation (Clustering MAE)", axes[1, 0]),
        ("Eff_MAE", "Global Integration (Efficiency MAE)", axes[1, 1])
    ]

    for metric_col, title, ax in metrics:
        # Dynamic markers prevent warnings
        sns.lineplot(
            data=df, x="Age", y=metric_col, hue="Model", style="Model",
            markers=True, dashes=False, markersize=10, linewidth=2.5, ax=ax
        )
        ax.set_title(title, fontsize=12, fontweight='bold')
        ax.set_xlabel("Held-Out Age (Weeks)")
        ax.set_ylabel("Error (Lower = Better)")
        ax.set_xticks([30, 34, 38])

        if ax != axes[0, 0]:
            ax.get_legend().remove()
        else:
            ax.legend(title="Architecture")

    plt.suptitle("Zero-Shot Age Interpolation: Extended Topological Error", fontsize=16, fontweight='bold', y=1.02)
    plt.tight_layout()
    plt.savefig("Extended_Holdout_Results.png", dpi=300)
    plt.show()


def plot_comprehensive_matrix_panel(dataset, trained_models, target_ages, device, static_features, edge_idx,
                                    window=1.0):
    """Generates a grid plotting Real vs Synthetic matrices across all ages."""

    model_types = [
        "Flow_Matching",
        "CVAE_Baseline",
        "Diffusion_Baseline",
        "Graph_Aware_DDIM"
    ]

    nrows = len(target_ages)
    ncols = len(model_types) + 1  # +1 for the Real Brain column

    fig, axes = plt.subplots(nrows, ncols, figsize=(3 * ncols, 3 * nrows))

    def prep_for_plot(mat):
        mat = np.nan_to_num(mat, nan=0.0, posinf=1e6, neginf=0.0)
        np.fill_diagonal(mat, 0)
        return np.log1p(mat) if np.max(mat) > 20 else mat

    for i, age in enumerate(target_ages):
        # --- COLUMN 0: Real Brain ---
        all_ages = dataset.metadata['AgeGA'].values
        test_mask = np.abs(all_ages - age) <= (window / 2)
        test_idx = np.where(test_mask)[0]

        if len(test_idx) > 0:
            real_matrix = dataset.matrices[test_idx[0]]
            sns.heatmap(prep_for_plot(real_matrix), ax=axes[i, 0], cmap='inferno', square=True,
                        cbar=False, xticklabels=False, yticklabels=False)
        else:
            axes[i, 0].text(0.5, 0.5, "No Real Data", ha='center', va='center')

        if i == 0:
            axes[i, 0].set_title("Real Brain\n(Ground Truth)", fontweight='bold', fontsize=14)
        axes[i, 0].set_ylabel(f"{age} Weeks", fontweight='bold', fontsize=14)

        for j, m_type in enumerate(model_types, start=1):
            model_key = f"{m_type}_Holdout_{age}w"

            if model_key in trained_models:
                model = trained_models[model_key]
                cfg_scale = 1.0 if any(kw in m_type for kw in ["Flow", "CVAE"]) else 2.0

                # Generate matrix
                vec = unified_sampler(model_key, model, age, device, static_features, edge_idx,
                                      guidance_scale=cfg_scale)
                syn_matrix = vector_to_adjacency_matrix(vec, 90)

                sns.heatmap(prep_for_plot(syn_matrix), ax=axes[i, j], cmap='inferno', square=True,
                            cbar=False, xticklabels=False, yticklabels=False)
            else:
                # Fallback if a model didn't train properly
                axes[i, j].text(0.5, 0.5, "Model Missing", ha='center', va='center')

            # Set Column Titles (Only on the top row)
            if i == 0:
                clean_name = m_type.replace("_", " ")
                axes[i, j].set_title(clean_name, fontweight='bold', fontsize=14)

    plt.suptitle("Connectome Topology Evolution: Real vs. Generative Models", fontsize=20, fontweight='bold', y=1.02)
    plt.tight_layout()
    plt.savefig("Comprehensive_Master_Grid.png", dpi=300, bbox_inches='tight')
    plt.show()


def plot_residual_comparison(dataset, trained_models, target_age, device, static_features, edge_idx, window=1.0):
    """Plots the absolute difference (residuals) between Real and Synthetic matrices."""

    all_ages = dataset.metadata['AgeGA'].values
    test_idx = np.where(np.abs(all_ages - target_age) <= (window / 2))[0]
    if len(test_idx) == 0: return
    real_matrix = dataset.matrices[test_idx[0]]

    models_to_compare = {k: v for k, v in trained_models.items() if
                         f"{target_age}w" in k and ("Flow" in k or "CVAE" in k)}

    fig, axes = plt.subplots(1, 3, figsize=(12, 4))

    def prep(mat):
        mat = np.nan_to_num(mat, nan=0.0, posinf=1e6, neginf=0.0)
        np.fill_diagonal(mat, 0)
        return np.log1p(mat) if np.max(mat) > 20 else mat

    R_prepped = prep(real_matrix)

    sns.heatmap(R_prepped, ax=axes[0], cmap='inferno', square=True, cbar=False, xticklabels=False, yticklabels=False)
    axes[0].set_title(f"Real Brain ({target_age}w)", fontweight='bold')

    for i, (name, model) in enumerate(models_to_compare.items(), start=1):
        cfg = 1.0
        vec = unified_sampler(name, model, target_age, device, static_features, edge_idx, guidance_scale=cfg)
        S_prepped = prep(vector_to_adjacency_matrix(vec, 90))

        # CALCULATE THE RESIDUAL (Absolute Error)
        residual = np.abs(R_prepped - S_prepped)

        sns.heatmap(residual, ax=axes[i], cmap='Reds', square=True, cbar=True, xticklabels=False, yticklabels=False,
                    vmax=np.max(R_prepped) * 0.5)
        clean_name = name.split(f"_Holdout")[0].replace("_", " ")
        axes[i].set_title(f"{clean_name} Error\n(White = Perfect, Dark Red = Error)", fontweight='bold', fontsize=10)

    plt.suptitle(f"Residual Error Maps at {target_age} Weeks", fontsize=14, fontweight='bold', y=1.05)
    plt.tight_layout()
    plt.savefig(f"Residuals_{target_age}w.png", dpi=300)
    plt.show()



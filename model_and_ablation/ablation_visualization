def compare_graph_metrics(trained_models, static_node_features, edge_indices,
                          device, dataset=None, target_ages=np.arange(24, 44, 4), num_samples=5):
    """
    Compare generated graph quality metrics across ablations, with a real-data baseline.
    """
    try:
        import networkx as nx
    except ImportError:
        print("NetworkX not available. Skipping graph metrics.")
        return

    results = {name: {'ages': [], 'efficiency': []} for name in trained_models.keys()}

    real_baseline = {'ages': [], 'efficiency': []}

    for age in target_ages:
        print(f"Computing metrics for Age {age}w...")

        if dataset is not None:
            # Grab all real patients within +/- 2 weeks of the target age
            real_ages = dataset.metadata['AgeGA'].values
            mask = (real_ages >= age - 2) & (real_ages < age + 2)
            valid_indices = np.where(mask)[0]

            if len(valid_indices) > 0:
                real_effs = []
                for idx in valid_indices:
                    mat = dataset.matrices[idx].copy()
                    np.fill_diagonal(mat, 0)

                    # Exact same thresholding as the generated models
                    thresh = np.percentile(mat, 85)
                    binary_mat = (mat >= thresh).astype(float)
                    G = nx.from_numpy_array(binary_mat)
                    real_effs.append(nx.global_efficiency(G))

                real_baseline['ages'].append(age)
                real_baseline['efficiency'].append(np.mean(real_effs))
            else:
                real_baseline['ages'].append(age)
                real_baseline['efficiency'].append(np.nan)  # No real data in this age bin

   
        for name, model in trained_models.items():
            efficiencies = []
            for _ in range(num_samples):
                vec = unified_sampler(name, model, age, device, static_node_features,
                                      edge_indices, guidance_scale=2.0)
                mat = vector_to_adjacency_matrix(vec, 90)

                # Threshold for binary graph
                thresh = np.percentile(mat, 85)
                binary_mat = (mat >= thresh).astype(float)
                G = nx.from_numpy_array(binary_mat)

                efficiencies.append(nx.global_efficiency(G))

            results[name]['ages'].append(age)
            results[name]['efficiency'].append(np.mean(efficiencies))


    plt.figure(figsize=(10, 6))

    # Plot real data baseline as a thick dashed black line
    if dataset is not None and len(real_baseline['ages']) > 0:
        plt.plot(real_baseline['ages'], real_baseline['efficiency'],
                 marker='s', markersize=8, linewidth=3, color='black',
                 linestyle='--', label='Real Data Baseline', zorder=5)

    # Plot generated models
    for name, data in results.items():
        plt.plot(data['ages'], data['efficiency'], marker='o', linewidth=2, label=name)

    plt.title("Graph Efficiency Across Gestational Age", fontsize=16, fontweight='bold')
    plt.xlabel("Gestational Age (weeks)")
    plt.ylabel("Global Efficiency")
    plt.legend()
    plt.grid(alpha=0.3)
    plt.tight_layout()
    plt.show()


def plot_training_curves(histories, save_path=None):
    """
    Compare training and validation curves across ablations.
    Handles models with different epoch counts.
    """
    fig, axes = plt.subplots(1, 2, figsize=(16, 6))

    colors = plt.cm.tab10(np.linspace(0, 1, len(histories)))

    for i, (name, history) in enumerate(histories.items()):
        color = colors[i]

        if 'train_loss' in history and len(history['train_loss']) > 0:
            epochs_t = range(1, len(history['train_loss']) + 1)
            axes[0].plot(epochs_t, history['train_loss'],
                         label=f"{name} (Train)", color=color, linewidth=2)

        if 'val_loss' in history and len(history['val_loss']) > 0:
            epochs_v = range(1, len(history['val_loss']) + 1)
            axes[1].plot(epochs_v, history['val_loss'],
                         label=f"{name} (Val)", color=color, linestyle='--', linewidth=2)

    axes[0].set_title("Training Convergence", fontsize=14, fontweight='bold')
    axes[0].set_xlabel("Epochs")
    axes[0].set_ylabel("Loss Magnitude")
    axes[0].legend()
    axes[0].grid(alpha=0.3, linestyle=':')
    axes[0].set_yscale('log')  # Log scale is often better if losses differ by orders of magnitude

    axes[1].set_title("Validation Generalization", fontsize=14, fontweight='bold')
    axes[1].set_xlabel("Epochs")
    axes[1].set_ylabel("Loss Magnitude")
    axes[1].legend()
    axes[1].grid(alpha=0.3, linestyle=':')
    axes[1].set_yscale('log')

    plt.suptitle("Ablation Study: Training Dynamics Comparison", fontsize=16, fontweight='bold', y=1.02)
    plt.tight_layout()

    if save_path:
        plt.savefig(save_path, dpi=300, bbox_inches='tight')
      print(f" Training curves saved to: {save_path}")

    plt.show()
